msgid "Account is inactive."
msgstr "Tài khoản không hoạt động."

msgid "Account locked due to too many failed attempts. Try again in %(minutes)d minutes."
msgstr "Tài khoản đã bị khóa do đăng nhập sai quá nhiều lần. Vui lòng thử lại sau %(minutes)d phút."

msgid "Account unlocked successfully"
msgstr "Mở khóa tài khoản thành công"

msgid "Account unlocked successfully. You can now log in."
msgstr "Mở khóa tài khoản thành công. Bạn có thể đăng nhập ngay bây giờ."

msgid "Authentication credentials were not provided."
msgstr "Thông tin xác thực chưa được cung cấp."

msgid "Error"
msgstr "Lỗi"

msgid "Handshake successful"
msgstr "Bắt tay thành công"

msgid "Header structure"
msgstr "Cấu trúc hệ thống"

msgid "Invalid client public key"
msgstr "Public key của client không hợp lệ"

msgid "Invalid credentials"
msgstr "Thông tin đăng nhập không hợp lệ"

msgid "Invalid credentials or account inactive"
msgstr "Thông tin đăng nhập không hợp lệ hoặc tài khoản không hoạt động"

msgid "Invalid data provided"
msgstr "Dữ liệu cung cấp không hợp lệ"

msgid "Invalid data provided."
msgstr "Dữ liệu cung cấp không hợp lệ."

msgid "Invalid or expired OTP"
msgstr "OTP không hợp lệ hoặc đã hết hạn"

msgid "Invalid or expired refresh token"
msgstr "Refresh token không hợp lệ hoặc đã hết hạn"

msgid "Login successful"
msgstr "Đăng nhập thành công"

msgid "Logout successful"
msgstr "Đăng xuất thành công"

msgid "Method \"%(method)s\" not allowed."
msgstr "Phương thức \"%(method)s\" không được hỗ trợ."

msgid "Missing or invalid 'public_key' (RSA PEM required)"
msgstr "Thiếu hoặc sai 'public_key' (yêu cầu RSA PEM)"

msgid "No account found with this identifier."
msgstr "Không tìm thấy tài khoản với thông tin này."

msgid "OTP sent. Please check your email."
msgstr "Đã gửi OTP. Vui lòng kiểm tra email của bạn."

msgid "Old password is incorrect."
msgstr "Mật khẩu cũ không đúng."

msgid "Old password is required."
msgstr "Vui lòng nhập mật khẩu cũ."

msgid "Password Reset OTP"
msgstr "OTP đặt lại mật khẩu"

msgid "Password changed successfully"
msgstr "Đổi mật khẩu thành công"

msgid "Password must be at least %(min_length)d characters."
msgstr "Mật khẩu phải có ít nhất %(min_length)d ký tự."

msgid "Password must be at least 8 characters with at least one uppercase letter, one lowercase letter, one digit, and one special character."
msgstr "Mật khẩu phải có ít nhất 8 ký tự, gồm ít nhất một chữ hoa, một chữ thường, một chữ số và một ký tự đặc biệt."

msgid "Password must contain at least one digit."
msgstr "Mật khẩu phải chứa ít nhất một chữ số."

msgid "Password must contain at least one lowercase letter."
msgstr "Mật khẩu phải chứa ít nhất một chữ cái thường."

msgid "Password must contain at least one special character."
msgstr "Mật khẩu phải chứa ít nhất một ký tự đặc biệt."

msgid "Password must contain at least one uppercase letter."
msgstr "Mật khẩu phải chứa ít nhất một chữ cái hoa."

msgid "Password reset successfully"
msgstr "Đặt lại mật khẩu thành công"

msgid "Passwords do not match"
msgstr "Mật khẩu không khớp"

msgid "Profile updated"
msgstr "Cập nhật hồ sơ thành công"

msgid "Registration successful. Please wait for approval."
msgstr "Đăng ký thành công. Vui lòng chờ phê duyệt."

msgid "Resource conflict."
msgstr "Xung đột dữ liệu."

msgid "Resource created successfully"
msgstr "Tạo tài nguyên thành công"

msgid "Resource not found"
msgstr "Không tìm thấy tài nguyên"

msgid "Resource not found."
msgstr "Không tìm thấy dữ liệu."

msgid "Service degraded"
msgstr "Dịch vụ suy giảm"

msgid "Service healthy"
msgstr "Dịch vụ hoạt động bình thường"

msgid "Service temporarily unavailable, try again later."
msgstr "Dịch vụ tạm thời không khả dụng, vui lòng thử lại sau."

msgid "Success"
msgstr "Thành công"

msgid "Token refreshed"
msgstr "Làm mới token thành công"

msgid "Too many requests. Please try again in %(minutes)d minute(s)."
msgstr "Quá nhiều yêu cầu. Vui lòng thử lại sau %(minutes)d phút."

msgid "Too many requests. Please try again in %(seconds)d second(s)."
msgstr "Quá nhiều yêu cầu. Vui lòng thử lại sau %(seconds)d giây."

msgid "Too many requests. Please try again later."
msgstr "Quá nhiều yêu cầu. Vui lòng thử lại sau."

msgid "You do not have permission to perform this action"
msgstr "Bạn không có quyền thực hiện hành động này"

msgid "You do not have permission to perform this action."
msgstr "Bạn không có quyền thực hiện hành động này."

msgid "Your OTP for password reset is %(otp)s. It expires in %(minutes)d minutes."
msgstr "Mã OTP đặt lại mật khẩu của bạn là %(otp)s. Mã hết hạn sau %(minutes)d phút."

msgid "alive"
msgstr "đang hoạt động"

msgid "degraded"
msgstr "giảm cấp"

msgid "healthy"
msgstr "khỏe mạnh"

msgid "not ready"
msgstr "chưa sẵn sàng"

msgid "ready"
msgstr "sẵn sàng"

msgid "unhealthy"
msgstr "không khỏe mạnh"
