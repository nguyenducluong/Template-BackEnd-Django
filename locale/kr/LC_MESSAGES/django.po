msgid ""
msgstr ""
"Project-Id-Version: Django API Server\n"
"PO-Revision-Date: 2026\n"
"Language: kr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Account is inactive."
msgstr "계정이 비활성화되었습니다."

msgid "Account locked due to too many failed attempts. Try again in %(minutes)d minutes."
msgstr "로그인 실패 횟수 초과로 계정이 잠겼습니다. %(minutes)d분 후에 다시 시도해 주세요."

msgid "Account unlocked successfully"
msgstr "계정 잠금이 해제되었습니다"

msgid "Account unlocked successfully. You can now log in."
msgstr "계정 잠금이 해제되었습니다. 지금 로그인할 수 있습니다."

msgid "Authentication credentials were not provided."
msgstr "인증 정보가 제공되지 않았습니다."

msgid "Error"
msgstr "오류"

msgid "Handshake successful"
msgstr "핸드셰이크 성공"

msgid "Header structure"
msgstr "시스템 구조"

msgid "Invalid client public key"
msgstr "클라이언트 공개키가 잘못되었습니다"

msgid "Invalid credentials"
msgstr "로그인 정보가 유효하지 않습니다"

msgid "Invalid credentials or account inactive"
msgstr "로그인 정보가 유효하지 않거나 계정이 비활성화되어 있습니다"

msgid "Invalid data provided"
msgstr "제공된 데이터가 잘못되었습니다"

msgid "Invalid data provided."
msgstr "제공된 데이터가 잘못되었습니다."

msgid "Invalid or expired OTP"
msgstr "OTP가 잘못되었거나 만료되었습니다"

msgid "Invalid or expired refresh token"
msgstr "리프레시 토큰이 잘못되었거나 만료되었습니다"

msgid "Login successful"
msgstr "로그인 성공"

msgid "Logout successful"
msgstr "로그아웃 성공"

msgid "Method \"%(method)s\" not allowed."
msgstr "\"%(method)s\" 메서드는 허용되지 않습니다."

msgid "Missing or invalid 'public_key' (RSA PEM required)"
msgstr "'public_key'가 없거나 잘못되었습니다 (RSA PEM 필요)"

msgid "No account found with this identifier."
msgstr "해당 정보로 등록된 계정을 찾을 수 없습니다."

msgid "OTP sent. Please check your email."
msgstr "OTP를 전송했습니다. 이메일을 확인해 주세요."

msgid "Old password is incorrect."
msgstr "기존 비밀번호가 올바르지 않습니다."

msgid "Old password is required."
msgstr "기존 비밀번호를 입력해 주세요."

msgid "Password Reset OTP"
msgstr "비밀번호 재설정 OTP"

msgid "Password changed successfully"
msgstr "비밀번호가 성공적으로 변경되었습니다"

msgid "Password must be at least %(min_length)d characters."
msgstr "비밀번호는 최소 %(min_length)d자 이상이어야 합니다."

msgid "Password must be at least 8 characters with at least one uppercase letter, one lowercase letter, one digit, and one special character."
msgstr "비밀번호는 최소 8자이며 대문자, 소문자, 숫자, 특수문자를 각각 하나 이상 포함해야 합니다."

msgid "Password must contain at least one digit."
msgstr "비밀번호에 숫자를 하나 이상 포함해야 합니다."

msgid "Password must contain at least one lowercase letter."
msgstr "비밀번호에 소문자를 하나 이상 포함해야 합니다."

msgid "Password must contain at least one special character."
msgstr "비밀번호에 특수문자를 하나 이상 포함해야 합니다."

msgid "Password must contain at least one uppercase letter."
msgstr "비밀번호에 대문자를 하나 이상 포함해야 합니다."

msgid "Password reset successfully"
msgstr "비밀번호가 재설정되었습니다"

msgid "Passwords do not match"
msgstr "비밀번호가 일치하지 않습니다"

msgid "Profile updated"
msgstr "프로필이 업데이트되었습니다"

msgid "Registration successful. Please wait for approval."
msgstr "회원가입이 완료되었습니다. 승인을 기다려 주세요."

msgid "Resource conflict."
msgstr "데이터 충돌이 발생했습니다."

msgid "Resource created successfully"
msgstr "리소스가 성공적으로 생성되었습니다"

msgid "Resource not found"
msgstr "리소스를 찾을 수 없습니다"

msgid "Resource not found."
msgstr "데이터를 찾을 수 없습니다."

msgid "Service degraded"
msgstr "서비스 성능 저하"

msgid "Service healthy"
msgstr "서비스 정상"

msgid "Service temporarily unavailable, try again later."
msgstr "서비스를 일시적으로 사용할 수 없습니다. 잠시 후 다시 시도해 주세요."

msgid "Success"
msgstr "성공"

msgid "Token refreshed"
msgstr "토큰이 갱신되었습니다"

msgid "Too many requests. Please try again in %(minutes)d minute(s)."
msgstr "요청이 너무 많습니다. %(minutes)d분 후에 다시 시도해 주세요."

msgid "Too many requests. Please try again in %(seconds)d second(s)."
msgstr "요청이 너무 많습니다. %(seconds)d초 후에 다시 시도해 주세요."

msgid "Too many requests. Please try again later."
msgstr "요청이 너무 많습니다. 잠시 후 다시 시도해 주세요."

msgid "You do not have permission to perform this action"
msgstr "이 작업을 수행할 권한이 없습니다"

msgid "You do not have permission to perform this action."
msgstr "이 작업을 수행할 권한이 없습니다."

msgid "Your OTP for password reset is %(otp)s. It expires in %(minutes)d minutes."
msgstr "비밀번호 재설정 OTP는 %(otp)s입니다. %(minutes)d분 후에 만료됩니다."

msgid "alive"
msgstr "실행 중"

msgid "degraded"
msgstr "성능 저하"

msgid "healthy"
msgstr "정상"

msgid "not ready"
msgstr "준비되지 않음"

msgid "ready"
msgstr "준비됨"

msgid "unhealthy"
msgstr "비정상"
