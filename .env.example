# Django
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
DJANGO_ENV=development

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=iqcg
DB_USER=postgres
DB_PASSWORD=1
DB_HOST=localhost
DB_PORT=5432
DB_DEFAULT_SCHEMA=public

# pgvector (bật tìm kiếm vector cho face embeddings)
USE_PGVECTOR=False

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=redis
REDIS_PASSWORD=redis-pass-local
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@example.com
# API Payload Encryption (RSA-OAEP + AES-256-GCM)
RSA_PRIVATE_KEY_PATH=certs/private_key.pem
RSA_PUBLIC_KEY_PATH=certs/public_key.pem
CRYPTO_SESSION_TTL=3600

# Max encrypted request body (bytes) - 15MB default
ENCRYPTION_MAX_BODY_SIZE=15728640

# ---- Rate limiting (2 tiers) ----
# Layer 1: global per-IP flood guard (middleware)
ENABLE_GLOBAL_RATE_LIMIT=True
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW=60
# Prefix loại trừ khỏi rate limit — chỉ THÊM vào danh sách bắt buộc trong
# config/settings/base.py (health, docs, static/media, admin luôn được loại trừ).
RATE_LIMIT_EXCLUDED_PREFIXES=/admin,/api/v1/health,/static,/media,/api/docs,/api/schema,/api/redoc,/api/v1/crypto

# Layer 2: per-scope DRF throttles
THROTTLE_AUTH=10/min
THROTTLE_CRYPTO_HANDSHAKE=10/min
THROTTLE_LOGIN=5/min
THROTTLE_REGISTER=3/hour
THROTTLE_ME=60/min
THROTTLE_USER_READ=120/min
THROTTLE_USER_WRITE=30/min
THROTTLE_FACE=20/min
THROTTLE_CORE=60/min
THROTTLE_SYSTEMS=120/min
THROTTLE_DEFAULT=100/min

# Fixed-window auth throttles (fallback used by Login/RegisterRateThrottle)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW=60
REGISTER_RATE_LIMIT=3
REGISTER_RATE_LIMIT_WINDOW=3600

# Account lockout after repeated failed logins
# LƯU Ý: tên biến phải khớp settings (ACCOUNT_LOCKOUT_MINUTES trong config/settings/base.py)
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ---- AI Assistant (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=300
OLLAMA_KEEP_ALIVE=30m
THROTTLE_AI=10/min

# Bật/tắt mã hóa payload API (RSA-OAEP handshake + AES-256-GCM qua EncryptionMiddleware)
# Mặc định: ON khi DJANGO_ENV != "development"; đặt True để bật mã hóa trong development
ENABLE_API_ENCRYPTION=False

# ---- Systems dialog actions (dispatcher apps.systems) ----
# Hành vi mặc định của submit_form khi hệ thống CHƯA có nơi lưu dữ liệu:
#   echo   = trả success + echo dữ liệu đã nhận (persisted=false) — mặc định ở dev
#   reject = trả 501 Not Implemented (khuyến nghị production khi chưa cấu hình)
SYSTEMS_SUBMIT_DEFAULT=echo
# Giới hạn tổng dung lượng file đính kèm cho 1 lần submit (MB) — server tự kiểm tra
SYSTEMS_UPLOAD_MAX_MB=15

# TTL cache quyền header theo user, giây (quyền T1 — apps/info/permissions.py)
SYSTEMS_PERM_CACHE_TTL=60

# ---- Chính sách HTTP method: CHỈ GET / POST / OPTIONS ----
# Lớp middleware chặn PUT/PATCH/DELETE trên /api/ (xem libs/http_policy.py).
# Đặt False chỉ khi thật sự cần tương thích ngược (không khuyến nghị).
ENFORCE_HTTP_METHOD_POLICY=True
# Throttle riêng cho POST /api/v1/info/dispatch
THROTTLE_INFO=120/min

# ---- Dispatcher info (POST /api/v1/info/dispatch) ----
# Đường GHI cấu hình header (create/update/delete/reorder): mặc định TẮT.
INFO_DISPATCH_WRITE_ENABLED=False
# Power được phép ghi: SystemPower.id hoặc SystemPower.power_en (rỗng = không ai)
INFO_DISPATCH_ALLOWED_POWERS=
# TTL cache cây menu header theo user, giây (0 = không cache)
INFO_STRUCTURE_CACHE_TTL=300