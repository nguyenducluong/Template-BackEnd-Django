# Django
# MEMO: DJANGO_SECRET_KEY -- Khóa bí mật Django (ký session/CSRF). Production PHẢI đổi, không commit.
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
# MEMO: DJANGO_DEBUG -- Chế độ debug, True chỉ dùng local, production để False.
DJANGO_DEBUG=False
# MEMO: DJANGO_ALLOWED_HOSTS -- Danh sách host được phép, cách nhau bằng dấu phẩy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*
# MEMO: DJANGO_ENV -- Môi trường chạy: development / staging / production.
DJANGO_ENV=development

# Database (PostgreSQL)
# MEMO: DB_ENGINE -- Engine DB Django (mặc định PostgreSQL).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=IQCG
DB_USER=postgres
DB_PASSWORD=1
DB_HOST=localhost
DB_PORT=5432
DB_DEFAULT_SCHEMA=public

# MEMO: USE_PGVECTOR -- Bật pgvector để tìm kiếm vector cho face embeddings (True/False).
USE_PGVECTOR=True

# Redis
# MEMO: REDIS_HOST -- Host Redis (cache + Celery broker).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=redis
REDIS_PASSWORD=redis-pass-local
# MEMO: REDIS_DB_CACHE -- Index DB Redis dùng làm cache.
REDIS_DB_CACHE=0
# MEMO: REDIS_DB_CELERY -- Index DB Redis dùng cho Celery.
REDIS_DB_CELERY=1

# Celery
# MEMO: CELERY_BROKER_URL -- URL broker Celery (thường là Redis).
CELERY_BROKER_URL=redis://localhost:6379/1
# MEMO: CELERY_RESULT_BACKEND -- URL lưu kết quả task Celery.
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
# MEMO: JWT_ACCESS_TOKEN_LIFETIME -- Tuổi access token (đơn vị phút).
JWT_ACCESS_TOKEN_LIFETIME=15
# MEMO: JWT_REFRESH_TOKEN_LIFETIME -- Tuổi refresh token (đơn vị theo ngày).
JWT_REFRESH_TOKEN_LIFETIME=7

# CORS
# MEMO: CORS_ALLOWED_ORIGINS -- Danh sách origin FE được phép gọi API, cách nhau dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Email
# MEMO: EMAIL_HOST -- Host SMTP gửi mail.
EMAIL_HOST=localhost
# MEMO: EMAIL_PORT -- Port SMTP (test local thường 1025 như MailHog).
EMAIL_PORT=25
# MEMO: EMAIL_HOST_USER -- User SMTP (để trống nếu server local không cần auth).
EMAIL_HOST_USER=
# MEMO: EMAIL_HOST_PASSWORD -- Mật khẩu SMTP (bảo mật).
EMAIL_HOST_PASSWORD=
# MEMO: EMAIL_USE_TLS -- Dùng TLS cho SMTP (True/False).
EMAIL_USE_TLS=False
# MEMO: DEFAULT_FROM_EMAIL -- Địa chỉ gửi mặc định cho mail hệ thống.
DEFAULT_FROM_EMAIL=noreply@example.com
# API Payload Encryption (RSA-OAEP + AES-256-GCM)
# MEMO: RSA_PRIVATE_KEY_PATH -- Đường dẫn file private key RSA (giải mã handshake).
RSA_PRIVATE_KEY_PATH=certs/private_key.pem
# MEMO: RSA_PUBLIC_KEY_PATH -- Đường dẫn file public key RSA (client lấy qua API).
RSA_PUBLIC_KEY_PATH=certs/public_key.pem
# MEMO: CRYPTO_SESSION_TTL -- Tuổi phiên mã hóa AES sau handshake (giây).
CRYPTO_SESSION_TTL=3600

# Max encrypted request body (bytes) - 15MB default
# MEMO: ENCRYPTION_MAX_BODY_SIZE -- Kích thước tối đa body mã hóa được chấp nhận (bytes, mặc định 15MB).
ENCRYPTION_MAX_BODY_SIZE=15728640

# ---- Rate limiting (2 tiers) ----
# Layer 1: global per-IP flood guard (middleware)
# MEMO: ENABLE_GLOBAL_RATE_LIMIT -- Bật tầng chặn flood toàn cục theo IP (middleware).
ENABLE_GLOBAL_RATE_LIMIT=True
# MEMO: RATE_LIMIT_GLOBAL_MAX -- Số request tối đa mỗi cửa sổ thời gian (tầng global).
RATE_LIMIT_GLOBAL_MAX=600
# MEMO: RATE_LIMIT_GLOBAL_WINDOW -- Cửa sổ thời gian giới hạn global (giây).
RATE_LIMIT_GLOBAL_WINDOW=60
# MEMO: RATE_LIMIT_EXCLUDED_PREFIXES -- Prefix URL loại trừ khỏi rate limit (health, docs, static, crypto...).
RATE_LIMIT_EXCLUDED_PREFIXES=/admin,/api/health,/static,/media,/docs,/schema,/api/v1/crypto

# Layer 2: per-scope DRF throttles
# MEMO: THROTTLE_AUTH -- Giới hạn chung nhóm auth (ví dụ 10/min).
THROTTLE_AUTH=10/min
# MEMO: THROTTLE_CRYPTO_HANDSHAKE -- Giới hạn handshake mã hóa (ví dụ 10/min).
THROTTLE_CRYPTO_HANDSHAKE=10/min
# MEMO: THROTTLE_LOGIN -- Giới hạn login (ví dụ 5/min) chống dò mật khẩu.
THROTTLE_LOGIN=5/min
# MEMO: THROTTLE_REGISTER -- Giới hạn đăng ký (ví dụ 3/hour) chống spam.
THROTTLE_REGISTER=3/hour
# MEMO: THROTTLE_ME -- Giới hạn API /me (thông tin user hiện tại).
THROTTLE_ME=60/min
# MEMO: THROTTLE_USER_READ -- Giới hạn đọc user (GET).
THROTTLE_USER_READ=120/min
# MEMO: THROTTLE_USER_WRITE -- Giới hạn ghi user (POST create/update/delete).
THROTTLE_USER_WRITE=30/min
# MEMO: THROTTLE_FACE -- Giới hạn API nhận diện khuôn mặt.
THROTTLE_FACE=20/min
# MEMO: THROTTLE_CORE -- Giới hạn nhóm API core.
THROTTLE_CORE=60/min
# MEMO: THROTTLE_DEFAULT -- Giới hạn mặc định cho API không có scope riêng.
THROTTLE_DEFAULT=100/min

# Fixed-window auth throttles (fallback used by Login/RegisterRateThrottle)
# MEMO: LOGIN_RATE_LIMIT -- Số lần login tối đa trong cửa sổ (fallback fixed-window).
LOGIN_RATE_LIMIT=5
# MEMO: LOGIN_RATE_LIMIT_WINDOW -- Cửa sổ tính login (giây).
LOGIN_RATE_LIMIT_WINDOW=60
# MEMO: REGISTER_RATE_LIMIT -- Số lần register tối đa trong cửa sổ.
REGISTER_RATE_LIMIT=3
# MEMO: REGISTER_RATE_LIMIT_WINDOW -- Cửa sổ tính register (giây).
REGISTER_RATE_LIMIT_WINDOW=3600

# Account lockout after repeated failed logins
# MEMO: ACCOUNT_LOCKOUT_MAX_ATTEMPTS -- Số lần đăng nhập sai tối đa trước khi khóa tài khoản.
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
# MEMO: ACCOUNT_LOCKOUT_WINDOW_MINUTES -- Tên cũ của ACCOUNT_LOCKOUT_MINUTES (giữ tương thích).
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15

# ---- AI Assistant (Ollama) ----
# MEMO: OLLAMA_BASE_URL -- Base URL Ollama phục vụ AI Assistant.
OLLAMA_BASE_URL=http://localhost:11434
# MEMO: OLLAMA_MODEL -- Tên model Ollama (ví dụ qwen2.5-coder:1.5b).
OLLAMA_MODEL=qwen2.5-coder:1.5b
# MEMO: OLLAMA_TIMEOUT -- Timeout gọi Ollama (giây).
OLLAMA_TIMEOUT=300
# MEMO: OLLAMA_KEEP_ALIVE -- Thời gian giữ model trong RAM (ví dụ 30m).
OLLAMA_KEEP_ALIVE=30m
# MEMO: THROTTLE_AI -- Giới hạn nhóm API AI.
THROTTLE_AI=60/min

# MEMO: APPEND_SLASH -- Tự thêm dấu / cuối URL (Django APPEND_SLASH).
APPEND_SLASH=False

# MEMO: ENABLE_API_ENCRYPTION -- Bật mã hóa payload API (RSA handshake + AES-GCM).
ENABLE_API_ENCRYPTION=False
# MEMO: AI_CHAT_ENABLED -- Bật/tắt tính năng AI chat (tự thêm, không có trong .env.example).
AI_CHAT_ENABLED=True
# MEMO: REFRESH_IDLE_SECONDS -- Phiên refresh hết hạn sau bao lâu không hoạt động (mặc định 7 ngày = 604800s).
REFRESH_IDLE_SECONDS=604800
# MEMO: REFRESH_ABSOLUTE_SECONDS -- Hạn tuyệt đối của phiên tính từ lúc LOGIN, không reset khi xoay token (30 ngày).
REFRESH_ABSOLUTE_SECONDS=2592000
# MEMO: REFRESH_SESSION_KEEP_DAYS -- Giữ bản ghi phiên hết hạn bao lâu để audit (0 = xóa ngay).
REFRESH_SESSION_KEEP_DAYS=7
# MEMO: JWT_REFRESH_REUSE_GRACE_SECONDS -- Đã bỏ (giữ để rollback). 0 = tắt.
JWT_REFRESH_REUSE_GRACE_SECONDS=0
# MEMO: THROTTLE_SYSTEMS -- Giới hạn nhóm API systems.
THROTTLE_SYSTEMS=120/min
# MEMO: ACCOUNT_LOCKOUT_MINUTES -- Số phút khóa tài khoản (tên chuẩn theo settings/base.py).
ACCOUNT_LOCKOUT_MINUTES=15
# MEMO: SYSTEMS_SUBMIT_DEFAULT -- Hành vi submit_form khi chưa có nơi lưu: echo = trả success + echo dữ liệu (dev).
SYSTEMS_SUBMIT_DEFAULT=echo
# MEMO: SYSTEMS_UPLOAD_MAX_MB -- Giới hạn tổng dung lượng file đính kèm mỗi lần submit (MB).
SYSTEMS_UPLOAD_MAX_MB=15
# MEMO: SYSTEMS_PERM_CACHE_TTL -- TTL cache quyền header theo user (giây, quyền T1).
SYSTEMS_PERM_CACHE_TTL=60
# MEMO: ENFORCE_HTTP_METHOD_POLICY -- Cưỡng chế chỉ cho GET/POST/OPTIONS trên /api/ (True khuyến nghị).
ENFORCE_HTTP_METHOD_POLICY=True
# MEMO: THROTTLE_INFO -- Giới hạn riêng cho POST /api/v1/info/dispatch.
THROTTLE_INFO=120/min
# MEMO: INFO_DISPATCH_WRITE_ENABLED -- Cho phép đường ghi cấu hình header qua dispatcher (mặc định False = tắt).
INFO_DISPATCH_WRITE_ENABLED=False
# MEMO: INFO_DISPATCH_ALLOWED_POWERS -- Power được phép ghi (SystemPower.id hoặc power_en, rỗng = không ai).
INFO_DISPATCH_ALLOWED_POWERS=
# MEMO: INFO_STRUCTURE_CACHE_TTL -- TTL cache cây menu header theo user (giây, 0 = không cache).
INFO_STRUCTURE_CACHE_TTL=60
