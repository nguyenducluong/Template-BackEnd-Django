# IQCG - Production .env template (copy to project root as .env and fill in)

# Django
DJANGO_SECRET_KEY=CHANGE-ME-to-a-50-char-random-string
DJANGO_DEBUG=False
DJANGO_ENV=production
DJANGO_ALLOWED_HOSTS=iqcg.example.com

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=iqcg
DB_USER=postgres
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5432
DB_DEFAULT_SCHEMA=system
DB_CONN_MAX_AGE=60

USE_PGVECTOR=False

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=CHANGE-ME
REDIS_DB_CACHE=0
REDIS_DB_CELERY=1

# Celery
CELERY_BROKER_URL=redis://:CHANGE-ME@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE-ME@localhost:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME=1440
JWT_REFRESH_TOKEN_LIFETIME=7

# API Payload Encryption
RSA_PRIVATE_KEY_PATH=certs/private_key.pem
RSA_PUBLIC_KEY_PATH=certs/public_key.pem
CRYPTO_SESSION_TTL=3600

# CORS
CORS_ALLOWED_ORIGINS=https://iqcg-frontend.example.com

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Sentry (optional)
# SENTRY_DSN=
