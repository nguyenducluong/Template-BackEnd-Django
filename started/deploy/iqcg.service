# IQCG - systemd unit (Linux production)
# /etc/systemd/system/iqcg.service

[Unit]
Description=IQCG Django API (Gunicorn)
After=network.target postgresql.service redis-server.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/iqcg
Environment="DJANGO_ENV=production"
Environment="DJANGO_SETTINGS_MODULE=config.settings"
ExecStart=/opt/iqcg/.venv/bin/gunicorn config.wsgi:application -c /opt/iqcg/started/deploy/gunicorn_conf.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

# Optional separate ASGI/WebSocket service (duplicate this file as iqcg-ws.service):
#   ExecStart=/opt/iqcg/.venv/bin/daphne -b 127.0.0.1 -p 8001 config.asgi:application

[Install]
WantedBy=multi-user.target
